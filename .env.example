# Tavily Search API
TAVILY_API_KEYS=YOUR_TAVILY_API_KEY

# OpenRouter API
OPENROUTER_API_KEYS=YOUR_OPENROUTER_API_KEY

# Must be a valid model ID supporting structured outputs
llm_model_name=YOUR_OPENROUTER_MODEL_ID

# Local development default; Docker Compose overrides this
REDIS_URL=redis://localhost:6379/0
